# Copy to a private file and pass it explicitly with --env-file.
SAYA_PROFILE=analytics
SAYA_ANALYTICS_PASSWORD=replace-me
SAYA_AI_PROVIDER=ollama
SAYA_AI_MODEL=qwen2.5-coder:14b
SAYA_AI_BASE_URL=http://localhost:11434
SAYA_API_KEY=replace-me-if-using-openai-compatible

# Environment-only MySQL profile. SAYA_DB_SSL_CA, when used, is PEM content;
# use a TOML file SecretRef for a CA path. The default TLS mode is verify-identity.
# SAYA_DB_TYPE=mysql
# SAYA_DB_HOST=localhost
# SAYA_DB_PORT=3306
# SAYA_DB_NAME=warehouse
# SAYA_DB_USER=saya_readonly
# SAYA_DB_PASSWORD=replace-me
# SAYA_DB_SSLMODE=verify-identity
# SAYA_DB_SSL_CA=-----BEGIN CERTIFICATE-----...

# Environment-only Snowflake profile. Browser SSO needs no secret, but requires
# an interactive TTY and is unavailable with --non-interactive or piped input.
# SAYA_DB_TYPE=snowflake
# SAYA_DB_ACCOUNT=xy12345
# SAYA_DB_USER=jane
# SAYA_DB_AUTH_TYPE=externalbrowser
# For keypair instead, prefer a connections.toml file SecretRef such as
# private_key = { file = "/absolute/path/to/rsa_key.p8" }. If using an
# environment-only profile, SAYA_DB_PRIVATE_KEY must be raw PEM content in the
# process environment; this line-oriented env file does not expand literal \n.
# SAYA_DB_AUTH_TYPE=keypair
# SAYA_DB_PRIVATE_KEY_PASSPHRASE=replace-me
# For user/password instead:
# SAYA_DB_AUTH_TYPE=userpass
# SAYA_DB_PASSWORD=replace-me
# Optional context:
# SAYA_DB_WAREHOUSE=ANALYTICS
# SAYA_DB_NAME=PROD
# SAYA_DB_SCHEMA=PUBLIC
# SAYA_DB_ROLE=ANALYST

# Environment-only DuckDB profile. File paths require this explicit setting.
# SAYA_DB_TYPE=duckdb
# SAYA_DB_PATH=./data/warehouse.duckdb
# SAYA_DB_READ_ONLY=true

# Environment-only PostgreSQL profile (alternative to connections.toml).
# SAYA_DB_TYPE=postgresql
# SAYA_DB_HOST=localhost
# SAYA_DB_PORT=5432
# SAYA_DB_NAME=warehouse
# SAYA_DB_USER=saya_readonly
# SAYA_DB_PASSWORD=replace-me
