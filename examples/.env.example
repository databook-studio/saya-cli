# Copy to a private file and pass it explicitly with --env-file.
SAYA_PROFILE=analytics
SAYA_ANALYTICS_PASSWORD=replace-me
SAYA_AI_PROVIDER=ollama
SAYA_AI_MODEL=qwen2.5-coder:14b
SAYA_AI_BASE_URL=http://localhost:11434
SAYA_API_KEY=replace-me-if-using-openai-compatible

# Environment-only MySQL profile. SAYA_DB_SSL_CA, when used, is PEM content;
# use a TOML file SecretRef for a CA path. The default TLS mode is verify-identity.
# SAYA_DB_TYPE=mysql
# SAYA_DB_HOST=localhost
# SAYA_DB_PORT=3306
# SAYA_DB_NAME=warehouse
# SAYA_DB_USER=saya_readonly
# SAYA_DB_PASSWORD=replace-me
# SAYA_DB_SSLMODE=verify-identity
# SAYA_DB_SSL_CA=-----BEGIN CERTIFICATE-----...

# Environment-only DuckDB profile. File paths require this explicit setting.
# SAYA_DB_TYPE=duckdb
# SAYA_DB_PATH=./data/warehouse.duckdb
# SAYA_DB_READ_ONLY=true

# Environment-only PostgreSQL profile (alternative to connections.toml).
# SAYA_DB_TYPE=postgresql
# SAYA_DB_HOST=localhost
# SAYA_DB_PORT=5432
# SAYA_DB_NAME=warehouse
# SAYA_DB_USER=saya_readonly
# SAYA_DB_PASSWORD=replace-me
