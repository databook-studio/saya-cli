# Copy to a private file and pass it explicitly with --env-file.
SAYA_PROFILE=analytics
SAYA_ANALYTICS_PASSWORD=replace-me
SAYA_AI_PROVIDER=ollama
SAYA_AI_MODEL=qwen2.5-coder:14b
SAYA_AI_BASE_URL=http://localhost:11434
SAYA_API_KEY=replace-me-if-using-openai-compatible

